# Normalize line endings: text files stored as LF in the repo. Fixes the
# CRLF/LF re-encoding noise observed across Windows-host / Linux-sandbox
# sessions (HANDOFF_backtest_diag.md working-tree note).
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary — never diff or normalize
*.png binary
*.xlsx binary
*.pdf binary
*.pem binary
*.pptx binary
*.docx binary
